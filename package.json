  "license": "MIT",
  "homepage": "https://github.com/HSJ-BanFan/splayer-chksz-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/HSJ-BanFan/splayer-chksz-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/HSJ-BanFan/splayer-chksz-plugin/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check src/plugin.js && node --check dist/chksz.splayer-source.js",
    "check:dist": "node scripts/check-dist.mjs",
